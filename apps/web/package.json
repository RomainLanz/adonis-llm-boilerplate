{
  "name": "@boilerplate/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./src/core/*.js",
    "#identity/*": "./src/identity/*.js",
    "#shared/*": "./src/shared/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#types/*": "./types/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "db:codegen": "kysely-codegen --dialect postgres --env-file .env --out-file types/db.ts",
    "db:migrate": "node ace migrate",
    "db:fresh": "node ace migrate:fresh",
    "db:rollback": "node ace migrate:rollback"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.1",
    "@boilerplate/design-system": "workspace:*",
    "@inertiajs/react": "^3.7.0",
    "@tuyau/core": "catalog:",
    "@vinejs/vine": "^4.4.0",
    "edge.js": "^6.5.1",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^3.0.0",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "catalog:",
    "@types/luxon": "^3.7.4",
    "@types/node": "~26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "hot-hook": "^1.0.0",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/*.ts"
    ]
  }
}
